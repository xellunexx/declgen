{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "electron/**/*.ts",
    "electron/**/*.cjs",
    "tests/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
